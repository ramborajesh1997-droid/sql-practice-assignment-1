15. [WINDOW FUNCTION] Display each employee's salary along with the average salary of their department using 
AVG() OVER(PARTITION BY ...). 
Answer: 
SELECT
emp_name,
salary,
Department
AVG(Salary) OVER(
PARTITION BY Department
)AS department_AVG_salary
FROM Employees;

16. [WINDOW FUNCTION] Rank employees by salary from highest to lowest across the whole company using RANK(). 
Display employee name, salary and rank. 
Answer: 
SELECT
    emp_name,
    dept_id,
    salary,
    RANK()
    OVER(
        ORDER BY salary DESC
    ) AS company_rank
FROM employees;

17. [WINDOW FUNCTION] Rank employees by salary within each department using DENSE_RANK(). Display employee 
name, dept_id, salary and department rank. 
Answer: 
SELECT
    emp_name,
    dept_id,
    salary,
    DENSE_RANK()
    OVER(
        PARTITION BY Dept_id
    ORDER BY Salary DESC )AS Department_Rank	
FROM employees;
COMMIT

18. [WINDOW FUNCTION] For each customer order, display the order amount and the customer's previous order 
amount using LAG(). Order the rows by customer_id and order_date. 
Answer: 
SELECT
    customer_id,
    order_date,
    LAG(amount)
    OVER(
        ORDER BY order_date
    ) AS previous_order
From orders;


19. [WINDOW FUNCTION] Calculate a running total of order amount for each customer using SUM() OVER(PARTITION 
BY ... ORDER BY ...). 
Answer: 
SELECT
    customer_id,
    order_id,
    amount,
    SUM(amount) OVER (
        PARTITION BY customer_id
        ORDER BY order_date
    ) AS running_total
FROM orders;



20. [MIXED] Find the top 2 highest-paid employees from each department. Use a window function and return 
employee name, dept_id, salary and rank. 
Answer: 
SELECT
    employee_name,
    dept_id,
    salary,
    RANK() OVER (
        PARTITION BY dept_id
        ORDER BY salary DESC
    ) AS rank
FROM employees;	
