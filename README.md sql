---1. [CTAS] Create a new table named high_salary_employees using CTAS. Store emp_id, emp_name, dept_id and salary 
for employees whose salary is greater than 60000. 

CREATE TABLE high_salary_Employees AS
SELECT emp_id, emp_name, dept_id, salary
FROM Employees
WHERE salary >= 60000;
Select * from high_salary_Employees

--2. [CTAS] Create a table named chennai_customers using CTAS containing customers who are from Chennai. 

