--3[CTAS] Create a table named department_salary_summary using CTAS. It should contain each dept_id and the 
average salary of employees in that department. 

CREATE TABLE department_salary_summary AS
Select dept_id,Avg(salary) As average_salary
From Employees 
Group by dept_id;	

